# sdkconfig.defaults — project-specific Kconfig overrides for ESP32C3 XIAO Monitor
# Applied automatically by ESP-IDF / PlatformIO on first build.

# HTTP server: larger header + task stack for SSE long-lived connections
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_TASK_STACK_SIZE=8192
CONFIG_HTTPD_WS_SUPPORT=y

# WiFi: enable SoftAP support
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ADC calibration (ESP32-C3 supports eFuse Two-Point calibration)
CONFIG_ADC_CALI_EFUSE_TP_ENABLE=y

# Increase log buffer for verbose output
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
